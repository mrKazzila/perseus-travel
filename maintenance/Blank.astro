---
const { locale = 'en' } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title></title>
    <style is:inline>html, body { margin: 0; min-height: 100vh; background: #f7f1e7; }</style>
  </head>
  <body></body>
</html>
